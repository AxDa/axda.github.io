<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Cape Fear River + Atlantic Sea Front</name>
    <description>Full polygon outlining the Cape Fear River mouth and Atlantic coastline from Bald Head Island to Carolina Beach.</description>

    <Style id="capeStyle">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>4d0000ff</color>
      </PolyStyle>
    </Style>

    <Placemark>
      <name>Cape Fear River + Sea Front Polygon</name>
      <styleUrl>#capeStyle</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>

              <!-- Bald Head Island / Cape Fear Point -->
              -77.993000,33.855000,0
              -77.990000,33.860000,0
              -77.985000,33.865000,0
              -77.980000,33.870000,0

              <!-- Fort Fisher coastline -->
              -77.970000,33.890000,0
              -77.965000,33.900000,0
              -77.960000,33.910000,0
              -77.955000,33.920000,0

              <!-- Kure Beach coastline -->
              -77.950000,33.930000,0
              -77.945000,33.940000,0
              -77.940000,33.950000,0
              -77.935000,33.960000,0

              <!-- Carolina Beach coastline -->
              -77.930000,33.970000,0
              -77.925000,33.980000,0
              -77.920000,33.990000,0
              -77.915000,34.000000,0
              -77.910000,34.010000,0
              -77.905000,34.020000,0
              -77.900000,34.030000,0
              -77.895000,34.040000,0

              <!-- Northern Carolina Beach limit -->
              -77.890000,34.050000,0

              <!-- Western river boundary back toward Wilmington -->
              -77.900000,34.045000,0
              -77.910000,34.040000,0
              -77.920000,34.035000,0
              -77.930000,34.030000,0
              -77.940000,34.020000,0
              -77.950000,34.010000,0
              -77.960000,34.000000,0
              -77.970000,33.990000,0
              -77.980000,33.980000,0
              -77.990000,33.970000,0
              -78.000000,33.960000,0

              <!-- Closing loop back to Cape Fear Point -->
              -77.995000,33.900000,0
              -77.993000,33.855000,0

            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

  </Document>
</kml>
